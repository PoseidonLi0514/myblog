---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Seal from '../components/Seal.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { getPosts } from '../lib/posts';
import { site } from '../site.config';

const posts = await getPosts();
const recent = posts.slice(0, site.homePosts);
const [first, second] = site.intro.heading;
---

<BaseLayout>
	<!-- 窄屏：单栏；中屏：分类在左侧页边；宽屏（≥ 80rem）：左栏固定介绍与分类，右栏滚动文章列表 -->
	<div class="with-side home">
		<div class="home-intro">
			<section class="hero">
				<h1 class="hero-title">
					<span class="line">{first}</span>
					<span class="line">{second}<Seal /></span>
				</h1>
				<p class="hero-body">{site.intro.body}</p>
				<ul class="hero-links">
					{
						site.links.map((link) => {
							const external = link.href.startsWith('http');
							return (
								<li>
									<a href={link.href} rel={external ? 'me noopener' : undefined}>
										{link.label}
										{external && <span aria-hidden="true"> ↗</span>}
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
			<CategoryNav posts={posts} />
		</div>
		<section class="side-main home-list" aria-labelledby="recent">
			<h2 class="section-head">
				<span id="recent">最近文章 · Recent</span>
				<a href="/posts/">全部 {posts.length} 篇 →</a>
			</h2>
			<PostList posts={recent} />
		</section>
	</div>
</BaseLayout>
