---
import 'katex/dist/katex.min.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = "Marvin's Blog", description = '' } = Astro.props;
const pageTitle = title === "Marvin's Blog" ? title : `${title} - Marvin's Blog`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		{description && <meta name="description" content={description} />}
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<nav class="nav">
			<a href="/" class="nav-title">Marvin's Blog</a>
		</nav>
		<main class="container">
			<slot />
		</main>
		<footer class="footer">
			<p>&copy; {new Date().getFullYear()} Marvin. Built with <a href="https://astro.build">Astro</a>.</p>
		</footer>
	</body>
</html>

<style is:global>
	/* --- Reset & Base --- */
	*, *::before, *::after { box-sizing: border-box; margin: 0; }

	:root {
		--c-bg: #fafaf9;
		--c-text: #1c1917;
		--c-muted: #78716c;
		--c-border: #e7e5e4;
		--c-accent: #2563eb;
		--c-accent-hover: #1d4ed8;
		--c-code-bg: #f5f5f4;
		--c-tag-bg: #dbeafe;
		--c-tag-text: #1e40af;
		--font-sans: system-ui, -apple-system, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace;
	}

	html { font-size: 16px; }
	body {
		font-family: var(--font-sans);
		color: var(--c-text);
		background: var(--c-bg);
		line-height: 1.7;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	/* --- Nav --- */
	.nav {
		padding: 1.25rem 2rem;
		border-bottom: 1px solid var(--c-border);
	}
	.nav-title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--c-text);
		text-decoration: none;
	}
	.nav-title:hover { color: var(--c-accent); }

	/* --- Container --- */
	.container {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
		flex: 1;
		width: 100%;
	}

	/* --- Footer --- */
	.footer {
		padding: 1.5rem 2rem;
		border-top: 1px solid var(--c-border);
		text-align: center;
		color: var(--c-muted);
		font-size: 0.875rem;
	}
	.footer a { color: var(--c-muted); }

	/* --- Links --- */
	a { color: var(--c-accent); text-decoration: none; }
	a:hover { color: var(--c-accent-hover); text-decoration: underline; }

	/* --- Article prose --- */
	.prose h1 { font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.3; }
	.prose h2 { font-size: 1.375rem; font-weight: 600; margin-top: 2.5rem; margin-bottom: 0.75rem; }
	.prose h3 { font-size: 1.125rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.5rem; }
	.prose p { margin-bottom: 1.25rem; }
	.prose ul, .prose ol { margin-bottom: 1.25rem; padding-left: 1.5rem; }
	.prose li { margin-bottom: 0.25rem; }
	.prose strong { font-weight: 600; }

	.prose code {
		font-family: var(--font-mono);
		font-size: 0.875em;
		background: var(--c-code-bg);
		padding: 0.15em 0.35em;
		border-radius: 4px;
	}

	.prose pre {
		background: #1e293b;
		color: #e2e8f0;
		padding: 1.25rem 1.5rem;
		border-radius: 8px;
		overflow-x: auto;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.prose pre code {
		background: none;
		padding: 0;
		border-radius: 0;
		color: inherit;
		font-size: inherit;
	}

	.prose blockquote {
		border-left: 3px solid var(--c-border);
		padding-left: 1rem;
		color: var(--c-muted);
		margin-bottom: 1.25rem;
	}

	/* --- Tags --- */
	.tag {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 500;
		background: var(--c-tag-bg);
		color: var(--c-tag-text);
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
	}

	/* --- Post list --- */
	.post-list { list-style: none; padding: 0; }
	.post-item { padding: 1.25rem 0; border-bottom: 1px solid var(--c-border); }
	.post-item:last-child { border-bottom: none; }
	.post-item-title {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--c-text);
		text-decoration: none;
		display: block;
		margin-bottom: 0.25rem;
	}
	.post-item-title:hover { color: var(--c-accent); text-decoration: none; }
	.post-item-meta { font-size: 0.875rem; color: var(--c-muted); margin-bottom: 0.35rem; }
	.post-item-desc { font-size: 0.9rem; color: var(--c-muted); }
	.post-tags { display: flex; gap: 0.375rem; margin-top: 0.5rem; flex-wrap: wrap; }

	/* --- KaTeX overrides --- */
	.katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.5rem 0; }
</style>
